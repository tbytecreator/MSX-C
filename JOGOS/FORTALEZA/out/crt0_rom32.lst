                           000000    79 ROM_PLAIN		= 0		; Plain ROM (no mapper)
                           000002    80 ROM_MAPPER_8K	= 2		; Mapper 8 KB
                           000002    81 ROM_ASCII8		= 2		;  ASCII-8 mapper
                           000003    82 ROM_KONAMI		= 3		;  Konami without SCC mapper
                           000004    83 ROM_KONAMI_SCC	= 4		;  Konami with SCC mapper
                           000005    84 ROM_NEO8		= 5		;  NEO-8 mapper
                           000006    85 ROM_YAMANOOTO	= 6		;  Yamanooto mapper
                           000007    86 ROM_POPOLON		= 7		;  Popolon SCC mapper
                           00000A    87 ROM_MAPPER_16K	= 10	; Mapper 16 KB
                           00000A    88 ROM_ASCII16		= 10	;  ASCII-16 mmaper
