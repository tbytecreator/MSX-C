                                    399 ; Check for skip key press
                                    400 ;------------------------------------------------------------------------------
                                    401 .macro SKIP_BOOT
                                    402 	.if ROM_SKIP
                                    403 	; Check for 'ESC' key press
                                    404 	ctr0_check_rom_skip:
                                    405 		in		a, (PPI_C)
                                    406 		and		#0xF0					; only change bits 0-3
                                    407 		or		#7						; check row number 7
                                    408 		out		(PPI_C), a
                                    409 		in		a, (PPI_B)				; read row into A
                                    410 		and		#ROM_SKIP_KEY
                                    411 		ret		z
                                    412 	.endif
