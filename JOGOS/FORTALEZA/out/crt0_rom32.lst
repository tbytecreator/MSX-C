                                     58 	; Set Page 2 slot equal to Page 1 slot
      000023                         59 	INIT_P1_TO_P2
                                      1 
      000023                          2 	crt0_p1_to_p2::
      000023 DB A8            [11]    3 		in		a, (PPI_A)				; A=[P3|P2|P1|P0] Get primary slots info
      000025 0F               [ 4]    4 		rrca
      000026 0F               [ 4]    5 		rrca							; A=[P0|P3|P2|P1]
      000027 E6 03            [ 7]    6 		and		a, #0b00000011			; A=[00|00|00|P1] Save Page 1 primary slot
      000029 4F               [ 4]    7 		ld		c, a					; C=[00|00|00|P1]
      00002A 21 C1 FC         [10]    8 		ld		hl, #EXPTBL				; HL=&EXPTBL
      00002D 85               [ 4]    9 		add		a, l
      00002E 6F               [ 4]   10 		ld		l, a
      00002F 7E               [ 7]   11 		ld		a, (hl)					; A=EXPTBL[P1]    See if the slot is expanded or not
      000030 E6 80            [ 7]   12 		and		a, #0x80				; A=[X|000|00|00] Keep only expansion flag
      000032 B1               [ 4]   13 		or		a, c					; A=[X|000|00|P1] Set MSB if so
      000033 4F               [ 4]   14 		ld		c, a					; C=[X|000|00|P1] Save it to [C]
      000034 2C               [ 4]   15 		inc		l						;                 Point to primary slot's SLTTBL entry
      000035 2C               [ 4]   16 		inc		l
      000036 2C               [ 4]   17 		inc		l
      000037 2C               [ 4]   18 		inc		l
      000038 7E               [ 7]   19 		ld		a, (hl)					; A=SLTTBL[P1]    Get what is currently output to expansion slot register
      000039 E6 0C            [ 7]   20 		and		a, #0b00001100			; A=[00|00|S1|00]
      00003B B1               [ 4]   21 		or		c						; A=[X|000|S1|P1] Finally form slot address
      00003C 26 80            [ 7]   22 		ld		h, #0x80				; H=Page 2
