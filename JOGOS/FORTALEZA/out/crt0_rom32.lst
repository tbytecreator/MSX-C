                           003804   107 POPOLON_CFGR	= #0x3804		; Configuration register
                           000000   108 POPOLON_CFGR_OE	= #0b00000000	; Offset enable (default mode)
                           000001   109 POPOLON_CFGR_OD	= #0b00000001	; Offset disable
